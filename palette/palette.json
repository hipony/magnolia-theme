{
	"name": "Magnolia",
	"description": "Dark theme with gentle colors with focus on C++",
	"colors": {
		"bg.base": {
			"hex": "#11122C",
			"role": "Editor, panels, widgets, menus"
		},
		"bg.chrome": {
			"hex": "#17183B",
			"role": "Activity bar, side bar, status bar, title bar, tab strip"
		},
		"bg.deep": {
			"hex": "#0D0E22",
			"role": "Darker than base: unfocused inactive tabs"
		},
		"fg": {
			"hex": "#FFD1DA",
			"role": "Magnolia pink: default foreground and UI accent; control keywords, types"
		},
		"fg.bright": {
			"hex": "#FFEBEF",
			"role": "Near-white pink: base text, variables"
		},
		"fg.bone": {
			"hex": "#E8EEEA",
			"role": "Off-white: decorators, language constants, heading 2"
		},
		"fg.muted": {
			"hex": "#9D8EA4",
			"role": "Muted mauve: disabled text, secondary labels"
		},
		"fg.faint": {
			"hex": "#75647C",
			"role": "Faint: inactive items, ignored files, resolved markers"
		},
		"fg.rose": {
			"hex": "#9F868A",
			"role": "Rose grey: punctuation, brackets, selections, line numbers"
		},
		"border": {
			"hex": "#6E5D75",
			"role": "Contrast borders, table borders"
		},
		"red": {
			"hex": "#f38ba8",
			"role": "Errors, deleted, breakpoints, self/this, emphasis"
		},
		"mint": {
			"hex": "#DCE5E0",
			"role": "Added/inserted, raw code, pale accents"
		},
		"green": {
			"hex": "#bbe5ab",
			"role": "Strings, numbers, success, ANSI green"
		},
		"blush": {
			"hex": "#FFE6F2",
			"role": "Modified files, enums, preprocessor directives"
		},
		"gold": {
			"hex": "#ffd600",
			"role": "Constants, enum members, concepts"
		},
		"sand": {
			"hex": "#ebd391",
			"role": "Warnings, ANSI yellow"
		},
		"peach": {
			"hex": "#ffce9c",
			"role": "Parameters, git conflicts, charts orange"
		},
		"punch": {
			"hex": "#FF90BC",
			"role": "Keywords, object properties"
		},
		"dusk": {
			"hex": "#7A6570",
			"role": "Greyed dark magnolia: highlight and selection backgrounds"
		},
		"lilac": {
			"hex": "#BFAEED",
			"role": "Function declarations"
		},
		"taupe": {
			"hex": "#D0B3B5",
			"role": "Info, links, function calls, property names"
		},
		"cream": {
			"hex": "#F5EEE0",
			"role": "Enum members, operators, list bullets"
		},
		"petal": {
			"hex": "#f5c2e7",
			"role": "Escapes, format placeholders, quotes, ANSI magenta"
		},
		"maroon": {
			"hex": "#eba0ac",
			"role": "Metavariables, JSDoc params, secondary deletions"
		},
		"sky": {
			"hex": "#89dceb",
			"role": "Type parameters, renamed files, info markers, ANSI cyan"
		},
		"azure": {
			"hex": "#74c7ec",
			"role": "Heading 5, brackets 5, ANSI blue"
		},
		"periwinkle": {
			"hex": "#b4befe",
			"role": "Heading 6, markdown link titles"
		},
		"rosewater": {
			"hex": "#f5e0dc",
			"role": "Cursors, regex ranges"
		},
		"flamingo": {
			"hex": "#f2cdcd",
			"role": "Packages, snippets, GraphQL aliases, math"
		},
		"comment": {
			"hex": "#A17D9B",
			"role": "Comments"
		},
		"rust": {
			"hex": "#AA7477",
			"role": "C++ preprocessor function names"
		},
		"ansi.black": {
			"hex": "#2b2c52",
			"role": "ANSI black (velvet surface)"
		},
		"ansi.black.bright": {
			"hex": "#454770",
			"role": "ANSI bright black"
		},
		"ansi.red.bright": {
			"hex": "#f7a3ba",
			"role": "ANSI bright red"
		},
		"ansi.green": {
			"hex": "#D4DED9",
			"role": "ANSI green (grey-tinted mint)"
		},
		"ansi.green.bright": {
			"hex": "#E2EAE6",
			"role": "ANSI bright green"
		},
		"ansi.yellow": {
			"hex": "#E9D190",
			"role": "ANSI yellow (soft gold)"
		},
		"ansi.yellow.bright": {
			"hex": "#F1E0A8",
			"role": "ANSI bright yellow"
		},
		"ansi.blue": {
			"hex": "#A9B4D6",
			"role": "ANSI blue (grey lavender)"
		},
		"ansi.blue.bright": {
			"hex": "#C0C9E6",
			"role": "ANSI bright blue"
		},
		"ansi.petal.bright": {
			"hex": "#f9d8ef",
			"role": "ANSI bright magenta"
		},
		"ansi.cyan": {
			"hex": "#9fd8cd",
			"role": "ANSI cyan (dusty aqua)"
		},
		"ansi.cyan.bright": {
			"hex": "#bfe9e0",
			"role": "ANSI bright cyan"
		}
	},
	"ansi": {
		"normal": [
			"ansi.black",
			"red",
			"ansi.green",
			"ansi.yellow",
			"ansi.blue",
			"petal",
			"ansi.cyan",
			"fg.muted"
		],
		"bright": [
			"ansi.black.bright",
