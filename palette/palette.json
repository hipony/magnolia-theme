{
	"name": "Magnolia",
	"description": "Dark theme with gentle colors with focus on C++",
	"colors": {
		"bg.base": { "hex": "#11122C", "role": "Editor, panels, widgets, menus" },
		"bg.chrome": { "hex": "#17183B", "role": "Activity bar, side bar, status bar, title bar, tab strip" },
		"bg.deep": { "hex": "#0D0E22", "role": "Darker than base: unfocused inactive tabs" },

		"fg": { "hex": "#FFD1DA", "role": "Magnolia pink: default foreground and UI accent; control keywords, types" },
		"fg.bright": { "hex": "#FFEBEF", "role": "Near-white pink: base text, variables" },
		"fg.bone": { "hex": "#E8EEEA", "role": "Off-white: decorators, language constants, heading 2" },
		"fg.muted": { "hex": "#9D8EA4", "role": "Muted mauve: disabled text, secondary labels" },
		"fg.faint": { "hex": "#6c5c73", "role": "Faint: inactive items, ignored files, resolved markers" },
		"fg.rose": { "hex": "#9F868A", "role": "Rose grey: punctuation, brackets, selections, line numbers" },
		"border": { "hex": "#5B4D61", "role": "Contrast borders, table borders" },

		"red": { "hex": "#f38ba8", "role": "Errors, deleted, breakpoints, self/this, emphasis" },
		"mint": { "hex": "#DCE5E0", "role": "Added/inserted, raw code, pale accents" },
		"green": { "hex": "#bbe5ab", "role": "Strings, numbers, success, ANSI green" },
		"blush": { "hex": "#FFE6F2", "role": "Modified files, enums, preprocessor directives" },
		"gold": { "hex": "#ffd600", "role": "Constants, enum members, concepts" },
		"sand": { "hex": "#ebd391", "role": "Warnings, ANSI yellow" },
		"peach": { "hex": "#ffce9c", "role": "Parameters, git conflicts, charts orange" },
		"punch": { "hex": "#FF90BC", "role": "Keywords, object properties" },
		"lilac": { "hex": "#BFAEED", "role": "Function declarations" },
		"taupe": { "hex": "#D0B3B5", "role": "Info, links, function calls, property names" },
		"cream": { "hex": "#F5EEE0", "role": "Enum members, operators, list bullets" },
		"petal": { "hex": "#f5c2e7", "role": "Escapes, format placeholders, quotes, ANSI magenta" },
		"maroon": { "hex": "#eba0ac", "role": "Metavariables, JSDoc params, secondary deletions" },
		"sky": { "hex": "#89dceb", "role": "Type parameters, renamed files, info markers, ANSI cyan" },
		"azure": { "hex": "#74c7ec", "role": "Heading 5, brackets 5, ANSI blue" },
		"periwinkle": { "hex": "#b4befe", "role": "Heading 6, markdown link titles" },
		"rosewater": { "hex": "#f5e0dc", "role": "Cursors, regex ranges" },
		"flamingo": { "hex": "#f2cdcd", "role": "Packages, snippets, GraphQL aliases, math" },
		"comment": { "hex": "#A17D9B", "role": "Comments" },
		"rust": { "hex": "#AA7477", "role": "C++ preprocessor function names" },

		"ansi.black": { "hex": "#2b2c52", "role": "ANSI black (velvet surface)" },
		"ansi.black.bright": { "hex": "#454770", "role": "ANSI bright black" },
		"ansi.red.bright": { "hex": "#f7a3ba", "role": "ANSI bright red" },
		"ansi.green": { "hex": "#aac6a4", "role": "ANSI green (dusty sage)" },
		"ansi.green.bright": { "hex": "#c6debc", "role": "ANSI bright green" },
		"ansi.yellow": { "hex": "#e6cfa3", "role": "ANSI yellow (champagne)" },
		"ansi.yellow.bright": { "hex": "#f1e2bd", "role": "ANSI bright yellow" },
		"ansi.periwinkle.bright": { "hex": "#ccd6ff", "role": "ANSI bright blue" },
		"ansi.petal.bright": { "hex": "#f9d8ef", "role": "ANSI bright magenta" },
		"ansi.cyan": { "hex": "#9fd8cd", "role": "ANSI cyan (dusty aqua)" },
		"ansi.cyan.bright": { "hex": "#bfe9e0", "role": "ANSI bright cyan" }
	},
	"ansi": {
		"normal": ["ansi.black", "red", "ansi.green", "ansi.yellow", "periwinkle", "petal", "ansi.cyan", "fg.muted"],
		"bright": ["ansi.black.bright", "ansi.red.bright", "ansi.green.bright", "ansi.yellow.bright", "ansi.periwinkle.bright", "ansi.petal.bright", "ansi.cyan.bright", "fg.bright"]
	},
	"konsole": {
		"background": "bg.base",
		"backgroundIntense": "bg.chrome",
		"backgroundFaint": "bg.base",
		"foreground": "fg",
		"foregroundIntense": "fg.bright",
		"foregroundFaint": "fg.muted"
	},
	"opencode": {
		"defs": {
			"magnolia": "fg",
			"text": "fg.bright",
			"muted": "fg.muted",
			"faint": "fg.faint",
			"rose": "fg.rose",
			"bgBase": "bg.base",
			"bgChrome": "bg.chrome",
			"border": "border"
		},
		"theme": {
			"primary": "magnolia",
			"secondary": "taupe",
			"accent": "petal",
			"error": "red",
			"warning": "sand",
			"success": "green",
			"info": "sky",
			"text": "fg",
			"textMuted": "muted",
			"background": "bgBase",
			"backgroundPanel": "bgChrome",
			"backgroundElement": "bgChrome",
			"border": "border",
			"borderActive": "magnolia",
			"borderSubtle": "faint",
			"diffAdded": "mint",
			"diffRemoved": "red",
			"diffContext": "muted",
			"diffHunkHeader": "comment",
			"diffHighlightAdded": "green",
			"diffHighlightRemoved": "red",
			"diffAddedBg": "#DCE5E026",
			"diffRemovedBg": "#f38ba826",
			"diffContextBg": "bgChrome",
			"diffLineNumber": "rose",
			"diffAddedLineNumberBg": "#DCE5E026",
			"diffRemovedLineNumberBg": "#f38ba826",
			"markdownText": "text",
			"markdownHeading": "red",
			"markdownLink": "taupe",
			"markdownLinkText": "periwinkle",
			"markdownCode": "mint",
			"markdownBlockQuote": "petal",
			"markdownEmph": "red",
			"markdownStrong": "red",
			"markdownHorizontalRule": "cream",
			"markdownListItem": "cream",
			"markdownListEnumeration": "cream",
			"markdownImage": "taupe",
			"markdownImageText": "taupe",
			"markdownCodeBlock": "mint",
			"syntaxComment": "comment",
			"syntaxKeyword": "punch",
			"syntaxFunction": "lilac",
			"syntaxVariable": "text",
			"syntaxString": "green",
			"syntaxNumber": "green",
			"syntaxType": "magnolia",
			"syntaxOperator": "cream",
			"syntaxPunctuation": "rose"
		}
	},
	"lint": {
		"allowlist": ["#00000000", "#000000aa", "#000000c0"]
	}
}
